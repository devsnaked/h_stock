# Onde o ./deploy.sh entrega. Copie para `deploy.env` (fora do git) e preencha.
#
# Os valores são lidos literais, do `=` até o fim da linha: senha com espaço,
# parêntese, cifrão ou aspas entra como está, sem escapar nada.

SERVER_HOST=203.0.113.10
SERVER_USER=root
SERVER_PORT=22

# Chave SSH, se não for uma das que o ssh já usa sozinho (~/.ssh/id_*).
SSH_KEY=

# Senha do SSH. Exige o `sshpass` instalado aqui na sua máquina.
#
# Deixe VAZIA para usar chave SSH — é o caminho recomendado: a chave não passa
# pela linha de comando, não fica num arquivo em texto puro e o servidor pode
# então recusar login por senha, que é metade da segurança de um SSH exposto.
SERVER_PASSWORD=

# `true` se o usuário acima não estiver no grupo `docker` e precisar de sudo.
SERVER_SUDO=false

# Onde o compose e o .env.prod ficam no servidor. O banco não mora aqui: fica
# no volume `h_stock_data`, gerido pelo docker.
REMOTE_DIR=/opt/h_stock
