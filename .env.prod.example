# Ambiente de produção. Copie para `.env.prod` (que não vai para o git) e
# preencha. Os dois segredos saem de `mix phx.gen.secret` — cada um o seu, e
# nunca os do exemplo.

# Domínio público. Precisa apontar para o IP da máquina ANTES de subir: é com
# ele que o Caddy pede o certificado.
PHX_HOST=loja.exemplo.com.br

# mix phx.gen.secret
SECRET_KEY_BASE=troque-me
# mix phx.gen.secret
# Assina os tokens de sessão: trocar este valor desconecta todo mundo.
TOKEN_SIGNING_SECRET=troque-me

# Caminho do banco dentro do container. Tem que ficar em /data — é lá que o
# volume persistente está montado.
DATABASE_PATH=/data/h_stock.db

# SQLite serializa escritas; o pool atende as leituras.
POOL_SIZE=5
DB_BUSY_TIMEOUT=5000

TIMEZONE=America/Sao_Paulo

# Verificação em duas etapas. Em produção fica ligada.
TOTP_REQUIRED=true

# O Nominatim (OpenStreetMap) exige identificação de quem chama; ponha um
# contato real, é o que a política de uso deles pede.
GEOCODING_USER_AGENT=h_stock/1.0 (contato@exemplo.com.br)

# Usados só pelo `bin/seed`, na primeira subida. Troque a senha no sistema
# assim que entrar; depois disso estas variáveis não fazem mais nada.
ADMIN_NICKNAME=admin
ADMIN_PASSWORD=troque-me-tambem
# Produtos e usuários de demonstração ficam fora de produção.
SEED_DEMO=false
