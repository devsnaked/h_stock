# Ambiente de produção. Copie para `.env.prod` (que não vai para o git) e
# preencha. Os dois segredos saem de `mix phx.gen.secret` — cada um o seu, e
# nunca os do exemplo.

# O endereço público. Sem domínio próprio, use o nome que o sslip.io deriva do
# IP do servidor — troque os pontos por hifens e acrescente `.sslip.io`:
#
#     130.185.238.30   ->   PHX_HOST=130-185-238-30.sslip.io
#
# É um serviço público e gratuito de DNS que devolve o próprio IP embutido no
# nome; não há nada para registrar nem administrar. Ele existe porque o Caddy
# precisa de um NOME para pedir o certificado: para um IP pelado o Let's
# Encrypt não emite, e sem certificado a senha e o código do 2FA viajariam em
# texto claro. Tendo domínio próprio um dia, é só trocar esta linha (e apontar
# o domínio para o IP antes).
PHX_HOST=203-0-113-10.sslip.io

# mix phx.gen.secret
SECRET_KEY_BASE=troque-me
# mix phx.gen.secret
# Assina os tokens de sessão: trocar este valor desconecta todo mundo.
TOKEN_SIGNING_SECRET=troque-me

# Caminho do banco dentro do container. Tem que ficar em /data — é lá que o
# volume persistente está montado.
DATABASE_PATH=/data/h_stock.db

# SQLite serializa escritas; o pool atende as leituras.
POOL_SIZE=5
DB_BUSY_TIMEOUT=5000

TIMEZONE=America/Sao_Paulo

# Verificação em duas etapas. Em produção fica ligada.
TOTP_REQUIRED=true

# Nome que o aplicativo autenticador (Google Authenticator, Authy, 1Password)
# mostra ao lado da conta. Trocá-lo não invalida quem já ativou — é rótulo, não
# segredo; o nome antigo só sai do aplicativo da pessoa numa nova ativação.
TOTP_ISSUER=Mercado

# O Nominatim (OpenStreetMap) exige identificação de quem chama; ponha um
# contato real, é o que a política de uso deles pede.
GEOCODING_USER_AGENT=h_stock/1.0 (contato@exemplo.com.br)

# Usados só pelo `bin/seed`, na primeira subida — o admin é o único usuário
# que o seed cria. Deixe `ADMIN_PASSWORD` vazia para o seed sortear uma senha
# forte e mostrá-la uma única vez; se preencher, use uma senha longa e troque-a
# no sistema assim que entrar. Depois do admin criado, estas duas não fazem
# mais nada.
ADMIN_NICKNAME=admin
ADMIN_PASSWORD=
